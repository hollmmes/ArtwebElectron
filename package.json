{
  "name": "artweb-electron",
  "version": "0.6.0",
  "description": "Art Web Tasarim - Sirket Ici Yonetim Uygulamasi",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron . --dev\"",
    "electron:build": "vite build && C:/Python314/python.exe backend/build_backend.py && electron-builder",
    "preview": "vite preview"
  },
  "author": "Art Web Tasarim",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "vite": "^6.3.5",
    "wait-on": "^8.0.3"
  },
  "dependencies": {
    "@lottiefiles/dotlottie-react": "^0.19.4",
    "electron-updater": "^6.3.9",
    "lucide-react": "^1.17.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "build": {
    "appId": "com.artweb.toolkit",
    "productName": "Art Web Toolkit",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": "backend/dist_pyinstaller/backend",
        "to": "backend"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": false,
      "perMachine": false,
      "allowElevation": true,
      "artifactName": "ArtWebToolkit-Setup-${version}.${ext}",
      "include": "build/installer.nsh"
    },
    "publish": {
      "provider": "github",
      "owner": "hollmmes",
      "repo": "ArtwebElectron"
    }
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.25.12": true
  }
}
